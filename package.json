{
  "name": "starling-bank-mcp-private",
  "version": "1.2.1",
  "description": "Read-only personal Starling Bank MCP for private ChatGPT tunnel",
  "license": "MIT",
  "author": "Adam Jones (domdomegg)",
  "repository": {
    "type": "git",
    "url": "https://github.com/e24z/starling-bank-mcp.git"
  },
  "bin": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run build && node ./dist/main.js",
    "test": "STARLING_BANK_ACCESS_TOKEN=test-token STARLING_BANK_BASE_URL=http://127.0.0.1:4010 vitest run",
    "test:watch": "STARLING_BANK_ACCESS_TOKEN=test-token STARLING_BANK_BASE_URL=http://127.0.0.1:4010 vitest --watch",
    "lint": "eslint",
    "clean": "rm -rf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-domdomegg": "^2.0.9",
    "tsconfig-domdomegg": "^1.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.1.13"
  },
  "private": true
}
